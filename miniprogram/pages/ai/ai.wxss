.msgs { padding: 24rpx; padding-bottom: 40rpx; }
.bubble { max-width: 88%; padding: 20rpx 24rpx; border-radius: 18rpx; margin-bottom: 20rpx; font-size: 28rpx; line-height: 1.6; }
.bubble.user { background: #2563eb; color: #fff; margin-left: auto; }
.bubble.ai { background: #fff; box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, .06); }
.bubble.sys { background: #eef4ff; color: #1d4ed8; margin: 0 auto; font-size: 24rpx; }
.dots::after { content: '…'; }
.draft { background: #f8fafc; border-radius: 12rpx; padding: 16rpx; margin-top: 12rpx; }
.draft-title { font-weight: 600; margin-bottom: 8rpx; }
.draft-row { font-size: 24rpx; color: #475467; padding: 4rpx 0; }
.draft-peer { font-size: 22rpx; color: #92400e; background: #fef3c7; border-radius: 8rpx; padding: 8rpx 12rpx; margin: 8rpx 0; }
.post-btn { margin-top: 10rpx; background: #2563eb !important; color: #fff !important; }
.input-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; gap: 16rpx; align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #e5e9f0;
}
.input-bar input { flex: 1; background: #f4f6fa; border-radius: 32rpx; padding: 16rpx 28rpx; }
.send-btn { background: #2563eb !important; color: #fff !important; }
