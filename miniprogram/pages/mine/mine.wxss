.head {
  display: flex; align-items: center; gap: 24rpx;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #101828, #1d2939); color: #fff;
}
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #2563eb; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: bold;
}
.u-name { font-size: 36rpx; font-weight: bold; }
.u-role { font-size: 24rpx; color: #98a2b3; margin-top: 6rpx; }
.group { padding: 8rpx 24rpx; }
.g-item { display: flex; justify-content: space-between; padding: 26rpx 8rpx; border-bottom: 1rpx solid #f0f2f5; }
.g-item:last-child { border-bottom: none; }
.arrow { color: #c0c4cc; }
.logout { justify-content: center; color: #dc2626; border-bottom: none; }
