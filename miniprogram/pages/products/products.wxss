.bar { display: flex; gap: 14rpx; padding: 20rpx 24rpx; align-items: center; }
.kw { flex: 1; background: #fff; border-radius: 12rpx; padding: 16rpx 24rpx; }
.seg { display: flex; background: #fff; border-radius: 12rpx; overflow: hidden; border: 1rpx solid #e5e9f0; }
.seg-item { padding: 16rpx 20rpx; font-size: 26rpx; color: #475467; white-space: nowrap; }
.seg-item.on { background: #2563eb; color: #fff; font-weight: 600; }
.add-btn { background: #16a34a; color: #fff; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 26rpx; white-space: nowrap; }
.crumb { padding: 0 24rpx 12rpx; font-size: 26rpx; color: #475467; }
.crumb-item { color: #2563eb; }
.card { background: #fff; border-radius: 16rpx; margin: 14rpx 24rpx; padding: 24rpx; box-shadow: 0 2rpx 8rpx rgba(16,24,40,.06); }
.cat-row { display: flex; align-items: center; gap: 20rpx; }
.c-icon { width: 64rpx; height: 64rpx; border-radius: 12rpx; background: #eff6ff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.c-main { flex: 1; }
.c-name { font-size: 30rpx; font-weight: 600; color: #1d2939; }
.p-row { display: flex; align-items: center; gap: 16rpx; }
.p-main { flex: 1; }
.p-name { font-size: 30rpx; font-weight: 600; color: #1d2939; }
.tag-peer { background: #fef3c7; color: #92400e; font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx; margin-left: 8rpx; vertical-align: middle; }
.p-right { text-align: right; }
.p-stock { font-size: 32rpx; font-weight: bold; }
.p-price { font-size: 24rpx; color: #667085; }
.p-ops { display: flex; flex-direction: column; gap: 8rpx; font-size: 26rpx; align-items: center; }
.op-edit { color: #2563eb; }
.op-del { color: #dc2626; }
.center { text-align: center; padding: 40rpx; }
.pager { display: flex; gap: 24rpx; align-items: center; justify-content: center; padding: 20rpx; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 9; display: flex; align-items: center; justify-content: center; }
.dialog { width: 640rpx; background: #fff; border-radius: 20rpx; padding: 36rpx 32rpx; max-height: 85vh; overflow-y: auto; }
.d-title { font-weight: bold; font-size: 32rpx; margin-bottom: 24rpx; }
.ipt { background: #f4f6fa; border-radius: 12rpx; padding: 18rpx 24rpx; margin-bottom: 20rpx; }
.c-row { display: flex; gap: 16rpx; }
.c-row .ipt { flex: 1; }
.pick-val { background: #f4f6fa; border-radius: 12rpx; padding: 18rpx 24rpx; margin-bottom: 16rpx; color: #1d2939; }
