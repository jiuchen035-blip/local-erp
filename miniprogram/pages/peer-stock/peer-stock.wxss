.bar { padding: 20rpx 24rpx; }
.kw { background: #fff; border-radius: 12rpx; padding: 16rpx 24rpx; }
.cats { display: flex; gap: 16rpx; padding: 0 24rpx 16rpx; flex-wrap: wrap; }
.cat-tag { background: #fff; border-radius: 24rpx; padding: 10rpx 24rpx; font-size: 24rpx; color: #475467; }
.ps-row { display: flex; justify-content: space-between; padding: 24rpx; }
.ps-name { font-weight: 600; }
.ps-price { color: #2563eb; font-weight: bold; font-size: 32rpx; text-align: right; }
.ps-ops { display: flex; gap: 20rpx; font-size: 24rpx; color: #2563eb; margin-top: 8rpx; justify-content: flex-end; }
.ps-ops .danger { color: #dc2626; }
.center { text-align: center; padding: 40rpx; }
.pager { display: flex; gap: 24rpx; align-items: center; justify-content: center; padding: 20rpx; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 9; display: flex; align-items: center; justify-content: center; }
.dialog { width: 620rpx; background: #fff; border-radius: 20rpx; padding: 36rpx 32rpx; }
.d-title { font-weight: bold; font-size: 32rpx; margin-bottom: 24rpx; }
.ipt { background: #f4f6fa; border-radius: 12rpx; padding: 18rpx 24rpx; margin-bottom: 20rpx; }
